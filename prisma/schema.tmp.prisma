// =============================================================================
// OpSolid — Dijital Kartvizit (DBC) — Prisma Schema
//
// Self-serve order pipeline: customer picks a numbered template, fills card
// content, pays via Stripe (one-time or subscription), we auto-publish at
// opsolid.de/c/{slug}. Enum-like fields are stored as String with allowed
// values documented inline and mirrored in src/lib/validation.ts (Zod enums).
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../.tmp-prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH (Faz 7.0a) — User accounts, sessions, magic-link tokens.
//
// Auth model is password-or-magic-link (either works). passwordHash is nullable
// so magic-link-only signups don't carry a fake hash. Sessions store SHA-256 of
// the actual session cookie value (never plaintext). MagicLinkToken is single-
// use: usedAt set when consumed; expires after 15 min.
//
// CardOrder.userId is added below as a nullable FK with onDelete: SetNull, so
// account deletion turns a user's cards into "orphan" cards (still publicly
// viewable, no longer editable). A future "claim card" flow (B0.6) lets old
// editToken-only cards be linked to a User account.
// =============================================================================

// -----------------------------------------------------------------------------
// User — auth identity. Email is the unique handle (lowercased in app code
// before insert). emailVerifiedAt is set when the user clicks a magic link,
// so an unverified row may exist briefly between signup and first link click.
// locale defaults to "de"; valid values mirror the i18n catalog: de | en | tr.
// -----------------------------------------------------------------------------
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String?   @map("password_hash")
  name            String?
  locale          String    @default("de")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  magicLinkTokens MagicLinkToken[]
  cardOrders      CardOrder[]

  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Session — server-side session record. tokenHash is SHA-256 of the random
// session token issued in the Set-Cookie. Plaintext token never persisted.
// userAgent is truncated to ~255 chars in app code; ipHash is sha256(ip+salt)
// for analytics, never raw IP. Sessions revoked by setting revokedAt; expired
// sessions cleaned by retention cron.
// -----------------------------------------------------------------------------
model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipHash    String?   @map("ip_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// MagicLinkToken — single-use email login token. tokenHash = sha256(token).
// usedAt set when consumed; subsequent attempts to reuse must be rejected.
// expiresAt typically createdAt + 15 min. Retention cron purges expired rows.
// -----------------------------------------------------------------------------
model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

// -----------------------------------------------------------------------------
// CardTemplate — numbered catalog entry. Seeded via prisma/seed.ts from the
// authoritative list in src/config/card-templates.ts. The config file is the
// source of truth; the DB copy lets admin pages join on templateId.
// -----------------------------------------------------------------------------
model CardTemplate {
  id                   Int      @id
  slug                 String   @unique
  name                 String
  sectorHint           String   @map("sector_hint")
  componentKey         String   @map("component_key")
  previewPath          String   @map("preview_path")
  oneTimeCents         Int      @map("one_time_cents")
  monthlyCents         Int?     @map("monthly_cents")
  yearlyCents          Int?     @map("yearly_cents")
  stripeOneTimePriceId String?  @map("stripe_one_time_price_id")
  stripeMonthlyPriceId String?  @map("stripe_monthly_price_id")
  stripeYearlyPriceId  String?  @map("stripe_yearly_price_id")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  orders CardOrder[]

  @@map("card_templates")
}

// -----------------------------------------------------------------------------
// CardOrder — one customer order. Becomes a published DBC at /c/{slug} after
// the in-house designer reviews the raw input (AWAITING_DESIGN) and publishes.
//   status flow:
//     PENDING_PAYMENT -> PAID -> AWAITING_DESIGN -> PUBLISHED (slug set)
//                   |                                    |
//                   +-> CANCELLED              +-> CANCELLED (subscription ended)
//                                               +-> REFUNDED
// -----------------------------------------------------------------------------
model CardOrder {
  id          String  @id @default(cuid())
  orderNumber Int     @unique @default(autoincrement()) @map("order_number")
  slug        String? @unique
  templateId  Int     @map("template_id")

  // Faz 7.0a — owner of the card. Nullable for legacy cards created before
  // accounts existed (and pre-account self-serve orders). onDelete: SetNull
  // so deleting an account turns the cards into "orphan" public cards rather
  // than wiping the customer-facing page. A future "claim card" flow (B0.6)
  // lets editToken-only cards be linked to a User.
  userId String? @map("user_id")

  contactName  String  @map("contact_name")
  contactEmail String  @map("contact_email")
  contactPhone String  @map("contact_phone")
  callMeBack   Boolean @default(false) @map("call_me_back")

  cardData Json @map("card_data")

  brandPrimaryHex String? @map("brand_primary_hex")
  brandAccentHex  String? @map("brand_accent_hex")

  photoPath String? @map("photo_path")
  logoPath  String? @map("logo_path")

  // Premium foundation fields (added 2026-04-23, dbc-premium-foundation migration)
  // ---------------------------------------------------------------------------
  // QR styling: { preset: "rounded"|"dots"|"diamond"|"gradient"|...,
  //               primary, accent, withLogo, withPhoto, ai?: { prompt, style, generatedUrl } }
  qrStyle Json? @map("qr_style")

  // Optional embedded video — YouTube or Vimeo URL only (host whitelisted in Zod).
  videoUrl String? @map("video_url")

  // Concierge add-on (+€20). When true, order goes through designer review
  // (AWAITING_DESIGN). When false, webhook auto-publishes self-serve.
  conciergeAddon Boolean @default(false) @map("concierge_addon")

  // Layout × Theme picker (overrides templateId's defaults when set).
  // layoutKey: "AuroraBento" | "CinemaHero" | ... (15 layouts)
  // themeKey:  "editorial" | "aurora" | ... (6 themes)
  layoutKey String? @map("layout_key")
  themeKey  String? @map("theme_key")

  // Drag-drop block editor state (Bento/Accordion layouts only).
  // [{ id, type: "Avatar"|"Heading"|"VideoEmbed"|..., props: {...}, position: {x,y,w,h} }]
  customBlocks Json? @map("custom_blocks")

  billingMode String @map("billing_mode")
  amountCents Int    @map("amount_cents")
  currency    String @default("EUR")
  locale      String @default("de")

  stripeSessionId       String? @unique @map("stripe_session_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripeSubscriptionId  String? @map("stripe_subscription_id")
  stripeCustomerId      String? @map("stripe_customer_id")

  status String

  designNotes String? @map("design_notes")
  editToken   String? @unique @map("edit_token")

  // Phase 8 — customer-chosen slug captured at order creation. Validated
  // for format + uniqueness then. The webhook/admin publish flow prefers
  // this value (re-checked for uniqueness) over the auto-generated
  // `name-xxxx` form.
  desiredSlug String? @map("desired_slug")

  // Phase 8 — every previous slug this card has had. Populated when the
  // owner renames their card from the edit page; the public route uses it
  // for 308 redirects so old WhatsApp / QR links keep working forever.
  slugHistory String[] @default([]) @map("slug_history")

  contactedAt      DateTime? @map("contacted_at")
  contactedByNote  String?   @map("contacted_by_note")
  paidAt           DateTime? @map("paid_at")
  awaitingDesignAt DateTime? @map("awaiting_design_at")
  publishedAt      DateTime? @map("published_at")

  // Phase 6 — per-card custom domain. Customer points
  // CNAME card.theirdomain.com → card.opsolid.de; we verify via DNS lookup
  // and once verified, middleware rewrites that host to /c/{slug}.
  customDomain           String?   @unique @map("custom_domain")
  customDomainVerified   Boolean   @default(false) @map("custom_domain_verified")
  customDomainVerifiedAt DateTime? @map("custom_domain_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template      CardTemplate         @relation(fields: [templateId], references: [id])
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription  Subscription?
  statusHistory OrderStatusHistory[]
  views         CardView[]
  leads         CardLead[]
  links         CardLink[]
  scanEvents    ScanEvent[]
  webhooks      CardWebhook[]

  /**
   * Connections received: visitors who sent their own card via Smart Exchange.
   */
  ownerConnections   CardConnection[] @relation("OwnerConnections")
  /**
   * Connections sent: this card was used as the visitor on someone else's card.
   */
  visitorConnections CardConnection[] @relation("VisitorConnections")

  /**
   * Album photos contributed to this card by owner or visitors.
   */
  albumPhotos CardAlbumPhoto[]

  @@index([status])
  @@index([contactPhone])
  @@index([callMeBack, contactedAt])
  @@index([userId])
  @@map("card_orders")
}

// -----------------------------------------------------------------------------
// Subscription — only populated for billingMode=SUBSCRIPTION orders.
// -----------------------------------------------------------------------------
model Subscription {
  id                   String    @id @default(cuid())
  orderId              String    @unique @map("order_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAt             DateTime? @map("cancel_at")
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// CardView — fire-and-forget view tracking from /c/[slug]/page.tsx server
// component. `source` distinguishes how the visitor reached the card (qr scan,
// nfc tap, direct link, wallet pass). Geo fields populated from Vercel headers.
// -----------------------------------------------------------------------------
model CardView {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  source    String? // qr | nfc | link | wallet
  ua        String? // user-agent prefix (truncated for privacy)
  country   String? // Vercel `x-vercel-ip-country`
  city      String? // Vercel `x-vercel-ip-city`
  referer   String?
  createdAt DateTime @default(now()) @map("created_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  // PII retention (Faz A8.3) — supports cron scan
  // `WHERE createdAt < NOW() - INTERVAL '13 months'`.
  @@index([createdAt])
  @@map("card_views")
}

// -----------------------------------------------------------------------------
// CardLead — opt-in "Bana ulaş" form submissions on a public card page. Owner
// gets an email notification + sees them in the dashboard at
// /[locale]/dashboard/cards/[editToken].
// -----------------------------------------------------------------------------
model CardLead {
  id      String  @id @default(cuid())
  orderId String  @map("order_id")
  name    String?
  email   String?
  phone   String?
  message String?

  // Phase 6 — separate structured fields (previously concat'd into message)
  interest       String? // "Pricing", "Demo", "General"
  meetingContext String? @map("meeting_context") // "Hannover Messe 2026"
  company        String?

  // Phase 6 — owner-side CRM fields
  ownerNotes      String?   @map("owner_notes") @db.Text
  tags            String[]  @default([])
  status          String    @default("new") // "new"|"contacted"|"qualified"|"archived"
  priority        Int       @default(0) // 0=normal, 1=high, 2=urgent
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt DateTime @default(now()) @map("created_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([orderId, status])
  // PII retention (Faz A8.3).
  @@index([createdAt])
  @@map("card_leads")
}

// -----------------------------------------------------------------------------
// CardLink — labelled short link for a published card. Code is the path segment
// at go.opsolid.de/<code> (host-rewritten to /l/<code> by middleware). Each
// link carries its own source/campaign/event labels so the owner can create
// distinct links per channel (qr-main, instagram-bio, nfc-card, hannover-messe)
// and see scan counts per source in the admin.
//
// destinationUrl is optional — defaults to /c/<order.slug>. When set, the link
// can deep-link to a sub-page or external resource (rare; future feature).
// -----------------------------------------------------------------------------
model CardLink {
  id             String   @id @default(cuid())
  orderId        String   @map("order_id")
  code           String   @unique
  label          String?
  source         String?
  campaign       String?
  medium         String?
  eventName      String?  @map("event_name")
  destinationUrl String?  @map("destination_url")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order      CardOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scanEvents ScanEvent[]

  @@index([orderId])
  @@map("card_links")
}

// -----------------------------------------------------------------------------
// ScanEvent — every short-link click on /l/<code>. The event is recorded
// before the 307 redirect to /c/<slug>, so we have analytics even when the
// destination page is cached or the user closes the tab mid-redirect.
//
// IP is hashed (sha256, no salt yet — Phase 6 will add a rotating server salt)
// to avoid storing raw addresses. Privacy-by-default: only enough signal to
// detect duplicate clicks within a short window.
// -----------------------------------------------------------------------------
model ScanEvent {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  linkId     String?  @map("link_id")
  source     String?
  campaign   String?
  eventName  String?  @map("event_name")
  referer    String?
  userAgent  String?  @map("user_agent")
  deviceType String?  @map("device_type") // mobile | tablet | desktop | bot
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  link  CardLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([linkId, createdAt])
  // PII retention (Faz A8.3).
  @@index([createdAt])
  @@map("scan_events")
}

// -----------------------------------------------------------------------------
// CardConnection — Smart Exchange link between two cards. When a visitor with
// their own published OpSolid card opens someone else's, they can press
// "Send my card" → we record a CardConnection row both sides can see in their
// admin (Phase 5 wires the UI). Status flow:
//   new → accepted | archived
// -----------------------------------------------------------------------------
model CardConnection {
  id            String  @id @default(cuid())
  ownerCardId   String  @map("owner_card_id")
  visitorCardId String  @map("visitor_card_id")
  source        String?
  campaign      String?
  eventName     String? @map("event_name")
  note          String?
  status        String  @default("new")

  // Phase 6 — owner-side CRM fields
  tags            String[]  @default([])
  priority        Int       @default(0)
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerCard   CardOrder @relation("OwnerConnections", fields: [ownerCardId], references: [id], onDelete: Cascade)
  visitorCard CardOrder @relation("VisitorConnections", fields: [visitorCardId], references: [id], onDelete: Cascade)

  /**
   * Album photos tagged as "with this connection".
   */
  albumPhotos CardAlbumPhoto[]

  @@unique([ownerCardId, visitorCardId])
  @@index([ownerCardId, createdAt])
  // PII retention (Faz A8.3).
  @@index([createdAt])
  @@map("card_connections")
}

// -----------------------------------------------------------------------------
// CardAlbumPhoto — kart başına album fotoğrafı. Sahip veya ziyaretçi yükler.
//   uploaderType: "owner" | "visitor"
//   status: "PENDING" | "APPROVED" | "REJECTED"
// Visitor fotoğrafları sahip onayından sonra görünür.
// connectionId: opsiyonel FK → CardConnection (bu fotoğrafı kimin ile çekildi)
// uploaderIpHash: sha256(ip + salt) — abuse detection, raw IP saklanmaz.
// -----------------------------------------------------------------------------
model CardAlbumPhoto {
  id             String    @id @default(cuid())
  cardOrderId    String    @map("card_order_id")
  uploaderType   String    @map("uploader_type") // "owner" | "visitor"
  uploaderName   String?   @map("uploader_name")
  uploaderIpHash String?   @map("uploader_ip_hash")
  photoPath      String    @map("photo_path")
  caption        String?   @db.Text
  connectionId   String?   @map("connection_id")
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now()) @map("created_at")
  approvedAt     DateTime? @map("approved_at")

  cardOrder  CardOrder       @relation(fields: [cardOrderId], references: [id], onDelete: Cascade)
  connection CardConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([cardOrderId, status])
  @@index([connectionId])
  @@map("card_album_photos")
}

// -----------------------------------------------------------------------------
// CardWebhook — outbound CRM webhook subscription for a card. Events fired:
//   lead.created       — when a CardLead is inserted via /api/cards/[slug]/lead
//   connection.created — when a CardConnection is upserted via .../exchange
// Each request is signed with HMAC-SHA256 of the body using `secret`. Failures
// are fire-and-forget (logged to Sentry); they do not block the user request.
// -----------------------------------------------------------------------------
model CardWebhook {
  id                 String    @id @default(cuid())
  orderId            String    @map("order_id")
  url                String
  secret             String
  events             String[]  @default(["lead.created", "connection.created"])
  active             Boolean   @default(true)
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastDeliveryStatus Int?      @map("last_delivery_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, active])
  @@map("card_webhooks")
}

// -----------------------------------------------------------------------------
// OrderStatusHistory — audit trail of status changes, admin notes, contact log.
// -----------------------------------------------------------------------------
model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  actor      String
  createdAt  DateTime @default(now()) @map("created_at")

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// =============================================================================
// VOICE AGENT PRODUCT
//
// AI phone receptionist product. Works in two modes:
//   - standalone: sold as OpSolid Voice Agent to any business
//   - kutasia_module: premium add-on for Kutasia CRM customers
//
// Provider abstraction: providerName = "retell" | "vapi" | "mock"
// All String "enum" fields are documented inline and mirrored in
// src/lib/voice/validation.ts as Zod enums.
// =============================================================================

// -----------------------------------------------------------------------------
// VoiceBillingPlan — catalog of available billing tiers. Seeded at deploy time.
//   planKey: "starter" | "growth" | "enterprise" | "kutasia_addon"
// -----------------------------------------------------------------------------
model VoiceBillingPlan {
  id               String   @id @default(cuid())
  planKey          String   @unique @map("plan_key")
  displayName      String   @map("display_name")
  monthlyMinutes   Int      @map("monthly_minutes")
  overageRateCents Int      @map("overage_rate_cents")
  monthlyCents     Int      @map("monthly_cents")
  yearlyCents      Int?     @map("yearly_cents")
  features         Json     @default("[]")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenants VoiceTenant[]

  @@map("voice_billing_plans")
}

// -----------------------------------------------------------------------------
// VoiceTenant — one business customer of the Voice Agent product.
//   mode:   "standalone" | "kutasia_module"
//   status: "trial" | "active" | "suspended" | "cancelled"
//   providerName: "retell" | "vapi" | "mock"
//   businessCategory: "restaurant" | "clinic" | "hotel" | "generic" | "appointment"
//
// Auth: tenantToken (URL ?token= for browser dashboard),
//       apiToken (Bearer for M2M calls, optional).
// Tenant provisioned by platform admin; tenantToken delivered by email.
// -----------------------------------------------------------------------------
model VoiceTenant {
  id                  String    @id @default(cuid())
  slug                String    @unique
  businessName        String    @map("business_name")
  contactEmail        String    @map("contact_email")
  contactPhone        String?   @map("contact_phone")
  timezone            String    @default("Europe/Berlin")
  locale              String    @default("de")
  mode                String    @default("standalone")
  status              String    @default("trial")
  planId              String?   @map("plan_id")
  tenantToken         String    @unique @map("tenant_token")
  webhookSecret       String    @map("webhook_secret")
  apiToken            String?   @unique @map("api_token")
  providerName        String    @default("retell") @map("provider_name")
  providerAccountId   String?   @map("provider_account_id")
  businessDescription String?   @map("business_description")
  businessAddress     String?   @map("business_address")
  businessCategory    String?   @map("business_category")
  kutasiaOrderId      String?   @unique @map("kutasia_order_id")
  featureFlags        Json      @default("{}") @map("feature_flags")
  trialEndsAt         DateTime? @map("trial_ends_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  plan             VoiceBillingPlan?         @relation(fields: [planId], references: [id])
  agents           VoiceAgent[]
  phoneNumbers     VoicePhoneNumber[]
  businessHours    VoiceBusinessHours[]
  handoffRules     VoiceHandoffRule[]
  knowledgeBase    VoiceKnowledgeBaseItem[]
  appointmentRules VoiceAppointmentRule[]
  integrations     VoiceIntegration[]
  notifConfigs     VoiceNotificationConfig[]
  usageRecords     VoiceUsageRecord[]
  testRuns         VoiceTestRun[]

  @@index([status])
  @@index([mode])
  @@map("voice_tenants")
}

// -----------------------------------------------------------------------------
// VoiceAgent — one AI receptionist configuration bound to a tenant.
//   status: "draft" | "active" | "paused" | "archived"
//   language: "de" | "tr" | "en" | "multilingual"
//   promptTemplate: "generic_receptionist" | "appointment_business" |
//                   "restaurant_reservation" | "restaurant_order" |
//                   "clinic" | "hotel"
// providerAgentId is the Retell/Vapi agent ID created on the provider side.
// -----------------------------------------------------------------------------
model VoiceAgent {
  id                      String    @id @default(cuid())
  tenantId                String    @map("tenant_id")
  name                    String
  displayName             String    @map("display_name")
  language                String    @default("de")
  voiceId                 String    @map("voice_id")
  status                  String    @default("draft")
  promptTemplate          String    @map("prompt_template")
  systemPrompt            String    @map("system_prompt") @db.Text
  providerAgentId         String?   @unique @map("provider_agent_id")
  maxDurationSeconds      Int       @default(600) @map("max_duration_seconds")
  interruptionSensitivity Float     @default(0.8) @map("interruption_sensitivity")
  responseDelayMs         Int       @default(500) @map("response_delay_ms")
  endCallPhrases          String[]  @default([]) @map("end_call_phrases")
  dtmfHandoffDigit        String?   @map("dtmf_handoff_digit")
  ambientSoundEnabled     Boolean   @default(false) @map("ambient_sound_enabled")
  providerOverrides       Json      @default("{}") @map("provider_overrides")
  lastSyncedAt            DateTime? @map("last_synced_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  tenant       VoiceTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumbers VoicePhoneNumber[]
  calls        VoiceCall[]
  testRuns     VoiceTestRun[]

  @@index([tenantId, status])
  @@map("voice_agents")
}

// -----------------------------------------------------------------------------
// VoicePhoneNumber — a phone number mapped to an agent.
//   status: "active" | "released" | "pending"
// providerPhoneId is the Retell/Vapi internal phone number ID.
// e164Number is the E.164-formatted number (e.g. "+4930123456789").
// -----------------------------------------------------------------------------
model VoicePhoneNumber {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  agentId         String?   @map("agent_id")
  e164Number      String    @unique @map("e164_number")
  friendlyName    String?   @map("friendly_name")
  providerPhoneId String?   @unique @map("provider_phone_id")
  status          String    @default("active")
  country         String    @default("DE")
  importedAt      DateTime  @default(now()) @map("imported_at")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls  VoiceCall[]

  @@index([tenantId])
  @@map("voice_phone_numbers")
}

// -----------------------------------------------------------------------------
// VoiceCall — one phone call record.
//   direction: "inbound" | "outbound"
//   status: "ringing" | "in_progress" | "ended" | "failed" | "busy" | "no_answer"
//   disposition: "answered" | "voicemail" | "transferred" | "abandoned"
//   outcomeType: "appointment_booked" | "order_placed" | "callback_requested" |
//                "info_provided" | "transferred" | "no_action" | "error"
//   processingStatus: "pending" | "processing" | "done" | "failed"
// extractedFields: structured JSON extracted from transcript
//   { name, email, phone, intent, requestedDate, requestedTime, service,
//     partySize, orderItems, address, urgency, nextAction, summary }
// -----------------------------------------------------------------------------
model VoiceCall {
  id                 String    @id @default(cuid())
  agentId            String    @map("agent_id")
  phoneNumberId      String?   @map("phone_number_id")
  providerCallId     String    @unique @map("provider_call_id")
  providerName       String    @map("provider_name")
  direction          String    @default("inbound")
  fromNumber         String    @map("from_number")
  toNumber           String    @map("to_number")
  status             String
  disposition        String?
  outcomeType        String?   @map("outcome_type")
  detectedLanguage   String?   @map("detected_language")
  sentiment          String?
  durationSeconds    Int?      @map("duration_seconds")
  recordingUrl       String?   @map("recording_url")
  recordingDeletedAt DateTime? @map("recording_deleted_at")
  transcriptJson     Json?     @map("transcript_json")
  transcriptText     String?   @map("transcript_text") @db.Text
  summaryText        String?   @map("summary_text") @db.Text
  extractedFields    Json      @default("{}") @map("extracted_fields")
  callerName         String?   @map("caller_name")
  callerEmail        String?   @map("caller_email")
  callerPhone        String?   @map("caller_phone")
  costUnits          Int?      @map("cost_units")
  processingStatus   String    @default("pending") @map("processing_status")
  processingError    String?   @map("processing_error")
  startedAt          DateTime? @map("started_at")
  endedAt            DateTime? @map("ended_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  agent       VoiceAgent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  phoneNumber VoicePhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  events      VoiceCallEvent[]
  usageRecord VoiceUsageRecord?

  @@index([agentId, startedAt])
  @@index([providerCallId])
  @@index([processingStatus])
  @@index([fromNumber])
  @@map("voice_calls")
}

// -----------------------------------------------------------------------------
// VoiceCallEvent — fine-grained event log per call (audit trail + debug).
//   eventType: "webhook_received" | "transcript_segment" | "recording_ready" |
//              "processing_started" | "appointment_created" | "order_created" |
//              "notification_sent" | "handoff_triggered" | "error"
// Insert-only (no updates). Each row is immutable.
// -----------------------------------------------------------------------------
model VoiceCallEvent {
  id        String   @id @default(cuid())
  callId    String   @map("call_id")
  eventType String   @map("event_type")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@map("voice_call_events")
}

// -----------------------------------------------------------------------------
// VoiceBusinessHours — weekly schedule + holiday overrides per tenant.
//   aiMode: "always_on" | "overflow" | "outside_hours" | "manual_off"
//   dayOfWeek: 0=Sunday .. 6=Saturday (JS Date.getDay() convention)
// Holiday overrides: isOverride=true, overrideDate="YYYY-MM-DD".
// Regular weekly rows: isOverride=false, overrideDate=null.
// The unique constraint prevents duplicate rows for the same day/date.
// -----------------------------------------------------------------------------
model VoiceBusinessHours {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  dayOfWeek     Int      @map("day_of_week")
  openTime      String   @map("open_time")
  closeTime     String   @map("close_time")
  isClosed      Boolean  @default(false) @map("is_closed")
  isOverride    Boolean  @default(false) @map("is_override")
  overrideDate  String?  @map("override_date")
  overrideLabel String?  @map("override_label")
  aiMode        String   @default("always_on") @map("ai_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek, isOverride, overrideDate])
  @@index([tenantId])
  @@map("voice_business_hours")
}

// -----------------------------------------------------------------------------
// VoiceHandoffRule — conditions for AI-to-human escalation.
//   triggerType: "keyword" | "sentiment" | "duration" | "dtmf" | "topic"
//   actionType: "transfer_call" | "send_sms" | "send_email" | "create_callback_task"
// Rules evaluated in sortOrder ascending; first match wins.
// actionConfig example: { transferNumber: "+49...", emailTo: "team@..." }
// -----------------------------------------------------------------------------
model VoiceHandoffRule {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  triggerType  String   @map("trigger_type")
  triggerValue String?  @map("trigger_value")
  actionType   String   @map("action_type")
  actionConfig Json     @default("{}") @map("action_config")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@map("voice_handoff_rules")
}

// -----------------------------------------------------------------------------
// VoiceKnowledgeBaseItem — FAQs, menus, pricing, policies the AI can cite.
//   itemType: "faq" | "menu" | "pricing" | "policy" | "team" | "location" | "custom"
// Items are rendered into the agent system prompt at sync time.
// -----------------------------------------------------------------------------
model VoiceKnowledgeBaseItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  itemType  String   @map("item_type")
  title     String
  content   String   @db.Text
  tags      String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, itemType])
  @@map("voice_knowledge_base_items")
}

// -----------------------------------------------------------------------------
// VoiceAppointmentRule — how the AI handles appointment/reservation/order flows.
//   bookingType: "direct_cal" | "direct_url" | "email_request" | "phone_callback"
//   conflictPolicy: "reject" | "offer_next" | "waitlist"
// calApiKey is stored encrypted-at-rest in production (env var encryption layer).
// requireFields: JSON string array, e.g. ["name","phone","email"]
// -----------------------------------------------------------------------------
model VoiceAppointmentRule {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  name             String
  isActive         Boolean  @default(true) @map("is_active")
  bookingType      String   @map("booking_type")
  calApiKey        String?  @map("cal_api_key")
  calEventTypeId   Int?     @map("cal_event_type_id")
  bookingUrl       String?  @map("booking_url")
  bufferMinutes    Int      @default(15) @map("buffer_minutes")
  minNoticeMinutes Int      @default(60) @map("min_notice_minutes")
  maxDaysAhead     Int      @default(30) @map("max_days_ahead")
  slotDurationMin  Int      @default(60) @map("slot_duration_min")
  conflictPolicy   String   @default("offer_next") @map("conflict_policy")
  confirmationMsg  String?  @map("confirmation_msg") @db.Text
  requireFields    Json     @default("[\"name\",\"phone\"]") @map("require_fields")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("voice_appointment_rules")
}

// -----------------------------------------------------------------------------
// VoiceIntegration — third-party connections (CRM, calendar, POS, webhook).
//   integrationType: "cal_com" | "google_calendar" | "custom_webhook" | "email_only"
//   status: "active" | "inactive" | "error"
// credentialsJson stored encrypted at rest. configJson is non-secret settings.
// -----------------------------------------------------------------------------
model VoiceIntegration {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  integrationType String    @map("integration_type")
  label           String?
  status          String    @default("inactive")
  credentialsJson Json?     @map("credentials_json")
  configJson      Json      @default("{}") @map("config_json")
  lastTestedAt    DateTime? @map("last_tested_at")
  lastErrorMsg    String?   @map("last_error_msg")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("voice_integrations")
}

// -----------------------------------------------------------------------------
// VoiceNotificationConfig — per-tenant post-call notification channels.
//   channelType: "email" | "telegram" | "whatsapp" | "webhook"
//   triggerOn: String[] event keys, e.g. ["call_ended","appointment_booked"]
// config: { to, botToken, chatId, url, secret } — channel-specific settings.
// Mirrors the channel pattern from src/lib/notifications.ts.
// -----------------------------------------------------------------------------
model VoiceNotificationConfig {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  channelType String   @map("channel_type")
  label       String?
  isActive    Boolean  @default(true) @map("is_active")
  triggerOn   String[] @default([]) @map("trigger_on")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("voice_notification_configs")
}

// -----------------------------------------------------------------------------
// VoiceUsageRecord — one record per completed call for billing/analytics.
//   billingMonth: "YYYY-MM"
//   billableMinutes: ceil(durationSeconds / 60)
// Aggregated monthly on-demand for billing dashboard.
// -----------------------------------------------------------------------------
model VoiceUsageRecord {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  callId          String   @unique @map("call_id")
  billingMonth    String   @map("billing_month")
  durationSeconds Int      @map("duration_seconds")
  billableMinutes Int      @map("billable_minutes")
  costUnits       Int      @default(0) @map("cost_units")
  overageUnits    Int      @default(0) @map("overage_units")
  overageCents    Int      @default(0) @map("overage_cents")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call   VoiceCall   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, billingMonth])
  @@map("voice_usage_records")
}

// -----------------------------------------------------------------------------
// VoiceTestRun — record of a test call initiated from the Voice Agent dashboard.
//   status: "initiated" | "completed" | "failed"
// providerCallId is set when the provider confirms the call was created.
// -----------------------------------------------------------------------------
model VoiceTestRun {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  agentId        String   @map("agent_id")
  toNumber       String   @map("to_number")
  providerCallId String?  @unique @map("provider_call_id")
  status         String   @default("initiated")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant VoiceTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  VoiceAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("voice_test_runs")
}
