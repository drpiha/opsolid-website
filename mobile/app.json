{
  "expo": {
    "name": "OpSolid",
    "slug": "opsolid-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "opsolid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.opsolid.mobile",
      "associatedDomains": ["applinks:opsolid.de"]
    },
    "android": {
      "package": "de.opsolid.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "opsolid.de",
              "pathPrefix": "/api/auth/magic-link/verify"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
