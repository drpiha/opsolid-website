# Contact Form — SMTP Configuration
# Set these to enable email delivery from the contact form.
# Without them, form submissions are logged to the console only.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=hello@opsolid.de
# Optional: overrides the From address on customer-facing order emails
# (confirmation, revision-ready, cancellation). If unset, SMTP_USER is used.
# Useful when SMTP_USER is an app-specific mailbox but you want customers to
# see a friendlier sender like "OpSolid <hello@opsolid.de>" in their inbox.
CONTACT_FROM_EMAIL=

# Cal.com — Booking Integration
# Create a free account at cal.com, connect Google Calendar,
# and create a 30-min "Discovery Call" event type.
NEXT_PUBLIC_CALCOM_USERNAME=solidra
NEXT_PUBLIC_CALCOM_EVENT=discovery-call
CALCOM_WEBHOOK_SECRET=your-webhook-secret

# Telegram Bot — Booking Notifications
# 1. Message @BotFather on Telegram, send /newbot
# 2. Copy the bot token
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# WhatsApp — Booking Notifications (CallMeBot)
# 1. Visit https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2. Follow the steps to get your API key
WHATSAPP_PHONE=4917631020654
WHATSAPP_CALLMEBOT_APIKEY=your-api-key

# Database — Self-hosted Postgres on Hostinger VPS (Kutasia shares the same host).
# Create a new database `opsolid_web` and a dedicated user before running
# `npx prisma db push` or `npx prisma db seed`.
DATABASE_URL=postgresql://opsolid_web:STRONG_PASSWORD_HERE@localhost:5432/opsolid_web?schema=public

# Stripe — payments (one-time + subscription).
# Create products + prices in the Stripe dashboard and paste IDs into
# src/config/card-templates.ts (stripeOneTimePriceId, stripeYearlyPriceId).
# Get your webhook secret after `stripe listen` (dev) or via the Stripe
# dashboard webhook endpoint for production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Public site URL — used in Stripe redirect URLs and the `/c/{slug}` links.
# In dev leave as http://localhost:3000; in prod set to https://opsolid.de.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel token — used as ?token=... on /admin/orders. Generate a long
# random string; never reuse across environments.
ADMIN_TOKEN=change-me-to-a-random-64-char-string

# M2M admin token — long random; distinct from ADMIN_TOKEN; machine-to-machine
# access from Kutasia's admin dashboard (/admin/opsolid-orders) to the
# /api/m2m/orders endpoints. Never used in a URL — only as a Bearer header.
M2M_ADMIN_TOKEN=change-me-to-a-different-random-64-char-string

# Sentry — observability. All four vars are OPTIONAL. When SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN are unset the SDK no-ops at runtime; when
# SENTRY_AUTH_TOKEN is unset source-map upload is skipped at build time.
# Don't force operators onto Sentry — leave these blank for a plain deploy.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — personal token with project:write scope. Never ship to prod.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: short git SHA embedded in /api/health so the operator can confirm
# which build is actually running on the VPS.
GIT_COMMIT=

# =============================================================================
# Auth (Faz 7.0a) — User accounts, magic-link login, JWT access tokens.
# =============================================================================
# 32+ random bytes (hex). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production. In dev a placeholder is used (with a loud warning).
JWT_SECRET=

# Magic-link token TTL (single-use email login). Default: 15 minutes.
MAGIC_LINK_TTL_MINUTES=15

# Refresh token (server-side session) TTL. Default: 30 days.
REFRESH_TOKEN_TTL_DAYS=30

# Access JWT TTL. Default: 15 minutes. Web SPA + mobile both call /api/auth/refresh
# when the access token expires; lower TTLs reduce blast radius of token theft.
ACCESS_TOKEN_TTL_MINUTES=15

# Salt for IP hashing on Session.ipHash and audit logs. Rotate periodically.
# Same value across instances is fine; cross-instance correlation is intentional.
AUTH_IP_SALT=

# =============================================================================
# Phase 6 — Apple Wallet pkpass signing.
# All five vars must be set together; missing any of them makes the
# /api/cards/[slug]/wallet/apple route return 503 and hides the wallet button.
# Provision via Apple Developer:
#   1. Enroll in the Apple Developer Program ($99/yr).
#   2. Create a Pass Type ID in Certificates, Identifiers & Profiles
#      (typically pass.de.opsolid.card).
#   3. Generate the Pass Type ID certificate (.p12), export as PEM:
#        openssl pkcs12 -in pass.p12 -clcerts -nokeys -out cert.pem
#        openssl pkcs12 -in pass.p12 -nocerts        -out key.pem
#   4. Download Apple WWDR certificate (G4) and convert to PEM.
# =============================================================================
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=

# =============================================================================
# GOOGLE WALLET PASS
# =============================================================================
# Step 1: console.cloud.google.com → enable "Google Wallet API"
# Step 2: IAM & Admin → Service Accounts → Create: "wallet-passes"
#         Role: Google Wallet Object Issuer
#         Create JSON key → download service-account.json
# Step 3: base64 encode (Linux/Mac):
#         base64 -w 0 service-account.json
#         (Windows PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Step 4: pay.google.com/business/console → "Get started" → create Issuer account
#         Copy the Issuer ID (format: 3388000000XXXXXXXXX)
#         NOTE: Google manually approves — takes 3-5 business days
# Step 5: Fill in the values below:
GOOGLE_WALLET_CREDENTIALS_BASE64=
GOOGLE_WALLET_ISSUER_ID=
# Optional — if you pre-provisioned a class via the Wallet API:
# GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_CLASS_ID=

# =============================================================================
# Voice Agent — AI Phone Receptionist product
# Set VOICE_AGENT_ENABLED=true to activate all /voice/* and /admin/voice/* routes.
# Without RETELL_API_KEY the system falls back to MockProvider (dev-safe, no calls).
# =============================================================================

# Master switch — false keeps all voice routes dormant
VOICE_AGENT_ENABLED=false

# Platform admin token — used as ?token=... on /admin/voice/*
# Generate: openssl rand -hex 32
VOICE_ADMIN_TOKEN=

# Primary provider: retell (live) or mock (dev, no API key needed)
VOICE_DEFAULT_PROVIDER=retell

# Retell AI — https://retell.ai
# Get your API key from the Retell dashboard → Settings → API Keys
# Register webhook URL: https://opsolid.de/api/voice/webhooks/retell
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# Vapi (future, skeleton only — do not set VAPI_API_KEY in production yet)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Public base URL — used for webhook registration URLs and admin deep-links
VOICE_PUBLIC_BASE_URL=https://opsolid.de

# Recording & retention
VOICE_ENABLE_RECORDING=false
VOICE_DEFAULT_RETENTION_DAYS=90

# Billing currency
VOICE_BILLING_CURRENCY=EUR

# Internal alert email — receives critical voice system errors
VOICE_INTERNAL_ALERT_EMAIL=

# Test mode — prevents live calls from being billed
VOICE_TEST_MODE=true

# Feature flags — all default false for safe zero-config deploys
VOICE_PROVIDER_RETELL_ENABLED=true
VOICE_PROVIDER_VAPI_ENABLED=false
VOICE_STANDALONE_MODE_ENABLED=false
VOICE_CALL_RECORDING_ENABLED=false
VOICE_BILLING_ENABLED=false
VOICE_ANALYTICS_ENABLED=true
VOICE_APPOINTMENT_BOOKING=false
VOICE_BUSY_HOUR_DETECTION=false

# =============================================================================
# Auth Email — Resend (primary) or SMTP fallback
# Provider precedence: RESEND_API_KEY → SMTP_HOST+SMTP_USER+SMTP_PASS → console
# Used by: magic-link, welcome, password-reset emails (src/lib/email/client.ts)
#
# Resend — https://resend.com (recommended; handles deliverability + EU routing)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@opsolid.de
#
# OR SMTP fallback (shares SMTP_HOST/PORT/USER/PASS with contact form above)
# SMTP_FROM overrides the From address for auth emails; falls back to SMTP_USER.
SMTP_FROM=noreply@opsolid.de
# =============================================================================
