# Contact Form â€” SMTP Configuration
# Set these to enable email delivery from the contact form.
# Without them, form submissions are logged to the console only.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=hello@opsolid.de
# Optional: overrides the From address on customer-facing order emails
# (confirmation, revision-ready, cancellation). If unset, SMTP_USER is used.
# Useful when SMTP_USER is an app-specific mailbox but you want customers to
# see a friendlier sender like "OpSolid <hello@opsolid.de>" in their inbox.
CONTACT_FROM_EMAIL=

# Cal.com â€” Booking Integration
# Create a free account at cal.com, connect Google Calendar,
# and create a 30-min "Discovery Call" event type.
NEXT_PUBLIC_CALCOM_USERNAME=solidra
NEXT_PUBLIC_CALCOM_EVENT=discovery-call
CALCOM_WEBHOOK_SECRET=your-webhook-secret

# Telegram Bot â€” Booking Notifications
# 1. Message @BotFather on Telegram, send /newbot
# 2. Copy the bot token
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# WhatsApp â€” Booking Notifications (CallMeBot)
# 1. Visit https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2. Follow the steps to get your API key
WHATSAPP_PHONE=4917631020654
WHATSAPP_CALLMEBOT_APIKEY=your-api-key

# Database â€” Self-hosted Postgres on Hostinger VPS (Kutasia shares the same host).
# Create a new database `opsolid_web` and a dedicated user before running
# `npx prisma db push` or `npx prisma db seed`.
DATABASE_URL=postgresql://opsolid_web:STRONG_PASSWORD_HERE@localhost:5432/opsolid_web?schema=public

# Stripe â€” payments (one-time + subscription).
# Create products + prices in the Stripe dashboard and paste IDs into
# src/config/card-templates.ts (stripeOneTimePriceId, stripeYearlyPriceId).
# Get your webhook secret after `stripe listen` (dev) or via the Stripe
# dashboard webhook endpoint for production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Public site URL â€” used in Stripe redirect URLs and the `/c/{slug}` links.
# In dev leave as http://localhost:3000; in prod set to https://opsolid.de.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional dedicated host for published cards. When set AND verified (below),
# QR codes and share images embed https://<host>/<slug> instead of
# opsolid.de/c/<slug>. 2026-06-12: card.opsolid.de is claimed by the separate
# Verso app's Traefik router, so QRs encoding it 404 — which is why the host
# alone is not enough.
NEXT_PUBLIC_CARD_HOST=
# Safety interlock for the host above. Set to "true" ONLY after
# `curl -I https://<host>/<any-published-slug>` returns this app's card page.
# Without it, the canonical opsolid.de/c/<slug> URLs are used everywhere.
CARD_HOST_VERIFIED=

# Stripe â€” Pro subscription price IDs. Used by /api/billing routes to start
# Pro upgrades from the dashboard. Both required only when Pro tier is
# offered to customers; can be left blank in dev.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Card pricing mode â€” the one switch between business models.
#   freemium  (default) FREE tier + paid tiers + optional Pro gates
#   all_free  everything free: paid tiers hidden in the order form, the
#             orders API coerces any paid request to FREE (Stripe is never
#             called), and every Pro feature gate is open.
CARD_PRICING_MODE=freemium

# Owner analytics gate. Basic analytics (views/leads/saves/shares) is FREE
# by default â€” set to "true" to re-arm the 402 pro_required gate on
# /api/v1/cards/[id]/analytics while running freemium.
CARD_ANALYTICS_PRO_ONLY=false

# Optional branded short-link host shown in owner link management and QR
# payloads. Falls back to "go.opsolid.de" when unset.
NEXT_PUBLIC_SHORT_HOST=

# Admin panel token â€” used as ?token=... on /admin/orders. Generate a long
# random string; never reuse across environments.
ADMIN_TOKEN=change-me-to-a-random-64-char-string

# M2M admin token â€” long random; distinct from ADMIN_TOKEN; machine-to-machine
# access from Kutasia's admin dashboard (/admin/opsolid-orders) to the
# /api/m2m/orders endpoints. Never used in a URL â€” only as a Bearer header.
M2M_ADMIN_TOKEN=change-me-to-a-different-random-64-char-string

# Sentry â€” observability. All four vars are OPTIONAL. When SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN are unset the SDK no-ops at runtime; when
# SENTRY_AUTH_TOKEN is unset source-map upload is skipped at build time.
# Don't force operators onto Sentry â€” leave these blank for a plain deploy.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only â€” personal token with project:write scope. Never ship to prod.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: short git SHA embedded in /api/health so the operator can confirm
# which build is actually running on the VPS.
GIT_COMMIT=

# =============================================================================
# Auth (Faz 7.0a) â€” User accounts, magic-link login, JWT access tokens.
# =============================================================================
# 32+ random bytes (hex). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production. In dev a placeholder is used (with a loud warning).
JWT_SECRET=

# Magic-link token TTL (single-use email login). Default: 15 minutes.
MAGIC_LINK_TTL_MINUTES=15

# Refresh token (server-side session) TTL. Default: 30 days.
REFRESH_TOKEN_TTL_DAYS=30

# Access JWT TTL. Default: 15 minutes. Web SPA + mobile both call /api/auth/refresh
# when the access token expires; lower TTLs reduce blast radius of token theft.
ACCESS_TOKEN_TTL_MINUTES=15

# Google Sign-In (OAuth 2.0) — powers "Continue with Google" on the web login
# page and the mobile app. REQUIRED only if you offer Google login; magic-link
# and password login work without it.
# Setup: console.cloud.google.com → APIs & Services → Credentials →
#   Create OAuth client ID (type: Web application). Add an Authorized redirect
#   URI that matches GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to <app URL>/api/auth/google/callback
#   prod: https://opsolid.de/api/auth/google/callback
#   dev:  http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Salt for IP hashing on Session.ipHash and audit logs. Rotate periodically.
# Same value across instances is fine; cross-instance correlation is intentional.
# SESSION_IP_SALT is an accepted alias â€” set either one. Code reads
# AUTH_IP_SALT first, then falls back to SESSION_IP_SALT.
AUTH_IP_SALT=
# SESSION_IP_SALT=

# Dev-only escape hatch for webhook-validator. When NODE_ENV !== production
# OR ALLOW_HTTP_WEBHOOKS=1, the webhook target URL may be plain http://.
# Never set this in production.
# ALLOW_HTTP_WEBHOOKS=

# =============================================================================
# Phase 6 â€” Apple Wallet pkpass signing.
# All five vars must be set together; missing any of them makes the
# /api/cards/[slug]/wallet/apple route return 503 and hides the wallet button.
# Provision via Apple Developer:
#   1. Enroll in the Apple Developer Program ($99/yr).
#   2. Create a Pass Type ID in Certificates, Identifiers & Profiles
#      (typically pass.de.opsolid.card).
#   3. Generate the Pass Type ID certificate (.p12), export as PEM:
#        openssl pkcs12 -in pass.p12 -clcerts -nokeys -out cert.pem
#        openssl pkcs12 -in pass.p12 -nocerts        -out key.pem
#   4. Download Apple WWDR certificate (G4) and convert to PEM.
# =============================================================================
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=

# =============================================================================
# GOOGLE WALLET PASS
# =============================================================================
# Step 1: console.cloud.google.com â†’ enable "Google Wallet API"
# Step 2: IAM & Admin â†’ Service Accounts â†’ Create: "wallet-passes"
#         Role: Google Wallet Object Issuer
#         Create JSON key â†’ download service-account.json
# Step 3: base64 encode (Linux/Mac):
#         base64 -w 0 service-account.json
#         (Windows PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Step 4: pay.google.com/business/console â†’ "Get started" â†’ create Issuer account
#         Copy the Issuer ID (format: 3388000000XXXXXXXXX)
#         NOTE: Google manually approves â€” takes 3-5 business days
# Step 5: Fill in the values below:
GOOGLE_WALLET_CREDENTIALS_BASE64=
GOOGLE_WALLET_ISSUER_ID=
# Optional â€” if you pre-provisioned a class via the Wallet API:
# GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_CLASS_ID=

# =============================================================================
# Voice Agent â€” AI Phone Receptionist product
# Set VOICE_AGENT_ENABLED=true to activate all /voice/* and /admin/voice/* routes.
# Without RETELL_API_KEY the system falls back to MockProvider (dev-safe, no calls).
# =============================================================================

# Master switch â€” false keeps all voice routes dormant
VOICE_AGENT_ENABLED=false

# Platform admin token â€” used as ?token=... on /admin/voice/*
# Generate: openssl rand -hex 32
VOICE_ADMIN_TOKEN=

# Primary provider: retell (live) or mock (dev, no API key needed)
VOICE_DEFAULT_PROVIDER=retell

# Retell AI â€” https://retell.ai
# Get your API key from the Retell dashboard â†’ Settings â†’ API Keys
# Register webhook URL: https://opsolid.de/api/voice/webhooks/retell
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# Vapi (future, skeleton only â€” do not set VAPI_API_KEY in production yet)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Public base URL â€” used for webhook registration URLs and admin deep-links
VOICE_PUBLIC_BASE_URL=https://opsolid.de

# Recording & retention
VOICE_ENABLE_RECORDING=false
VOICE_DEFAULT_RETENTION_DAYS=90

# Billing currency
VOICE_BILLING_CURRENCY=EUR

# Internal alert email â€” receives critical voice system errors
VOICE_INTERNAL_ALERT_EMAIL=

# Test mode â€” prevents live calls from being billed
VOICE_TEST_MODE=true

# Feature flags â€” all default false for safe zero-config deploys
VOICE_PROVIDER_RETELL_ENABLED=true
VOICE_PROVIDER_VAPI_ENABLED=false
VOICE_STANDALONE_MODE_ENABLED=false
VOICE_CALL_RECORDING_ENABLED=false
VOICE_BILLING_ENABLED=false
VOICE_ANALYTICS_ENABLED=true
VOICE_APPOINTMENT_BOOKING=false
VOICE_BUSY_HOUR_DETECTION=false

# =============================================================================
# Auth Email â€” Resend (primary) or SMTP fallback
# Provider precedence: RESEND_API_KEY â†’ SMTP_HOST+SMTP_USER+SMTP_PASS â†’ console
# Used by: magic-link, welcome, password-reset emails (src/lib/email/client.ts)
#
# Resend â€” https://resend.com (recommended; handles deliverability + EU routing)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@opsolid.de
#
# OR SMTP fallback (shares SMTP_HOST/PORT/USER/PASS with contact form above)
# SMTP_FROM overrides the From address for auth emails; falls back to SMTP_USER.
SMTP_FROM=noreply@opsolid.de

# =============================================================================
# M1 â€” Frictionless creation (sub-30s onboarding wizard).
# Both keys are OPTIONAL. When unset, the corresponding endpoint returns 503
# `{ error: "ocr_not_configured" }` / `{ error: "ai_not_configured" }` and
# the mobile wizard surfaces a friendly "Coming soon" state on the Step-0
# scan/url tap-cards.
# =============================================================================
# Google Cloud Vision â€” OCR for paper-card scanning.
# Region: pick an EU multi-region for GDPR posture. Restrict the key to the
# Vision API + the VPS's outbound IP in the GCP console.
# Cost: $1.50 / 1k DOCUMENT_TEXT_DETECTION calls (free tier: 1k / month).
GOOGLE_CLOUD_VISION_API_KEY=

# Anthropic - Optional secondary provider. Not used by Inbox v2 today (the AI
# layer calls OpenAI), but card draft-from-url (Verso) reads this when set.
# Leave blank unless you specifically want Anthropic.
ANTHROPIC_API_KEY=

# OpenAI - PRIMARY AI provider for Inbox v2.
#   - gpt-4o-mini: thread summary / sentiment / intent classification
#   - gpt-4o:      reply drafts (channel-tone aware)
#   - whisper-1:   voice-note transcription (WhatsApp / Telegram audio)
# Without this key the inbox still works, but AI badges + drafts go quiet.
# Get from https://platform.openai.com/api-keys (Project key recommended).
# Typical SMB cost ~ EUR 2-5 / month at fair-demo volumes.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY
# =============================================================================

# =============================================================================
# M7 â€” Paste-URL â†’ social profile enrichment
#   POST /api/v1/enrichment/from-url
# Both keys are OPTIONAL.
# =============================================================================
# GitHub â€” public users API. When unset, the endpoint uses anonymous fetch
# (60 requests/hour shared across the whole VPS). Set a fine-grained PAT with
# zero scopes (it only needs anonymous-equivalent read of public profiles)
# to raise the limit to 5000/hour. Generate at:
#   https://github.com/settings/tokens?type=beta
# Ship NO scopes. The token is only used for rate-limit elevation.
GITHUB_TOKEN=
#
# YouTube Data API v3 â€” needed to resolve YouTube channel URLs to
# displayName / subscriberCount / avatar. Without it, youtube.com URLs fall
# back to OpenGraph (which Google heavily restricts â€” most fields will be
# missing). Enable at:
#   console.cloud.google.com â†’ APIs & Services â†’ enable "YouTube Data API v3"
#   â†’ Credentials â†’ Create API key (restrict to YouTube Data API + the VPS IP).
# Free tier: 10 000 units / day; channels.list costs 1 unit per call.
YOUTUBE_API_KEY=
# =============================================================================

# =============================================================================
# M4 â€” Real-time comms (Expo Push notifications).
# =============================================================================
# OPTIONAL. When set, the server attaches `Authorization: Bearer ${EXPO_ACCESS_TOKEN}`
# to every Expo Push request â€” this raises the rate limit from anonymous tier
# and unlocks delivery receipts. Generate at:
#   https://expo.dev/accounts/<your-account>/settings/access-tokens
# When unset, anonymous Expo Push still works for development (no token, lower
# rate limit, no receipts). Recommended in production for any non-trivial DAU.
EXPO_ACCESS_TOKEN=
# =============================================================================
