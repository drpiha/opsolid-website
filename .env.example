# Contact Form — SMTP Configuration
# Set these to enable email delivery from the contact form.
# Without them, form submissions are logged to the console only.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=hello@opsolid.de
# Optional: overrides the From address on customer-facing order emails
# (confirmation, revision-ready, cancellation). If unset, SMTP_USER is used.
# Useful when SMTP_USER is an app-specific mailbox but you want customers to
# see a friendlier sender like "OpSolid <hello@opsolid.de>" in their inbox.
CONTACT_FROM_EMAIL=

# Cal.com — Booking Integration
# Create a free account at cal.com, connect Google Calendar,
# and create a 30-min "Discovery Call" event type.
NEXT_PUBLIC_CALCOM_USERNAME=solidra
NEXT_PUBLIC_CALCOM_EVENT=discovery-call
CALCOM_WEBHOOK_SECRET=your-webhook-secret

# Telegram Bot — Booking Notifications
# 1. Message @BotFather on Telegram, send /newbot
# 2. Copy the bot token
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# WhatsApp — Booking Notifications (CallMeBot)
# 1. Visit https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2. Follow the steps to get your API key
WHATSAPP_PHONE=4917631020654
WHATSAPP_CALLMEBOT_APIKEY=your-api-key

# Database — Self-hosted Postgres on Hostinger VPS (Kutasia shares the same host).
# Create a new database `opsolid_web` and a dedicated user before running
# `npx prisma db push` or `npx prisma db seed`.
DATABASE_URL=postgresql://opsolid_web:STRONG_PASSWORD_HERE@localhost:5432/opsolid_web?schema=public

# Stripe — payments (one-time + subscription).
# Create products + prices in the Stripe dashboard and paste IDs into
# src/config/card-templates.ts (stripeOneTimePriceId, stripeYearlyPriceId).
# Get your webhook secret after `stripe listen` (dev) or via the Stripe
# dashboard webhook endpoint for production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Public site URL — used in Stripe redirect URLs and the `/c/{slug}` links.
# In dev leave as http://localhost:3000; in prod set to https://opsolid.de.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel token — used as ?token=... on /admin/orders. Generate a long
# random string; never reuse across environments.
ADMIN_TOKEN=change-me-to-a-random-64-char-string

# M2M admin token — long random; distinct from ADMIN_TOKEN; machine-to-machine
# access from Kutasia's admin dashboard (/admin/opsolid-orders) to the
# /api/m2m/orders endpoints. Never used in a URL — only as a Bearer header.
M2M_ADMIN_TOKEN=change-me-to-a-different-random-64-char-string

# Sentry — observability. All four vars are OPTIONAL. When SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN are unset the SDK no-ops at runtime; when
# SENTRY_AUTH_TOKEN is unset source-map upload is skipped at build time.
# Don't force operators onto Sentry — leave these blank for a plain deploy.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — personal token with project:write scope. Never ship to prod.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: short git SHA embedded in /api/health so the operator can confirm
# which build is actually running on the VPS.
GIT_COMMIT=
